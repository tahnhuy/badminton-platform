# Database configuration (matches docker-compose.yml defaults)
DATABASE_URL="postgres://badminton_user:badminton_password@localhost:5433/badminton_db"
DIRECT_URL="postgres://badminton_user:badminton_password@localhost:5433/badminton_db"

# Server configuration
NODE_ENV="development"
PORT=3000

# Authentication secrets
# Must be a valid base64-encoded string decoding to at least 32 bytes
PASSWORD_PEPPER="PLACEHOLDER_NOT_A_REAL_SECRET_MUST_BE_AT_LEAST_32_BYTES_BASE64=="

# Cookie & Proxy configuration
COOKIE_SECURE=false
TRUST_PROXY=false

# Authentication Rate Limiting
RATE_LIMIT_LOGIN_MAX=20
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_REGISTER_WINDOW_MINUTES=60
RATE_LIMIT_OWNER_REQUEST_MAX=5
RATE_LIMIT_OWNER_REQUEST_WINDOW_MINUTES=60

# Public frontend origin used in email links
APP_PUBLIC_URL=http://localhost:5173
RATE_LIMIT_PASSWORD_CHANGE_MAX=10
RATE_LIMIT_PASSWORD_CHANGE_WINDOW_MINUTES=15

# Private media root (Social Tech Design §7.4). Required in every environment.
# Absolute path to an existing, writable directory OUTSIDE backend/uploads (the
# public static root). The server refuses to start otherwise; there is no fallback.
# Back it up together with the database. Local example (create it first):
#   mkdir -p ../private-uploads
PRIVATE_UPLOADS_DIR="/absolute/path/to/badminton-platform/private-uploads"


# Payment provider for booking payments: WALLET (default) | VNPAY | MOCK (dev/test only).
PAYMENT_PROVIDER="WALLET"

# SePay Payment Gateway (sandbox/production). Top-up only; payouts are Admin-approved manual transfers.
# Leave the bank values empty to disable SePay; missing config fails fast instead of falling back to Mock.
SEPAY_WEBHOOK_SECRET=""
SEPAY_BANK_CODE=""
SEPAY_BANK_ACCOUNT=""
SEPAY_ACCOUNT_NAME=""
SEPAY_QR_BASE_URL="https://vietqr.app/img"
# Wallet payout auto-approval is a SYSTEM_CONFIGS key (finance domain):
# WALLET_AUTO_APPROVE_PAYOUTS. Default true for sandbox/demo; Admin still marks paid.

# Infrastructure kill-switch for the Owner earnings worker. Business behaviour is
# controlled by SYSTEM_CONFIGS.OWNER_EARNING_AUTO_CREDIT_ENABLED (default true).
OWNER_EARNING_JOB_ENABLED=true

# Email delivery (Resend). Production requires real values; dev/test use a fake adapter when empty.
RESEND_API_KEY=""
EMAIL_FROM="SmashPro <no-reply@example.com>"

# Email OTP / withdrawal PIN secrets. Production requires distinct values.
# Box secrets outside the repository; never commit real values.
OTP_HMAC_SECRET=""
WITHDRAWAL_PIN_PEPPER=""
